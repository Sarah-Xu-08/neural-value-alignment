#!/usr/bin/env bash
set -e

NOTEBOOKS=(
  behavioral_analysis_fig3/fig_beh.ipynb
  eeg_analysis_fig4/fig_psd_onlyForVis.ipynb
  eeg_decoding_analysis_fig5/fig_gradcam_onlyForVis.ipynb
  nva_simulation_fig6789/fig_model_comparison_onlyForVis.ipynb
)

for nb in "${NOTEBOOKS[@]}"; do
  echo "Running $nb"
  jupyter nbconvert \
    --to html \
    --execute \
    --ExecutePreprocessor.timeout=-1 \
    --ExecutePreprocessor.allow_errors=True \
    --FilesWriter.build_directory=../results \
    "$nb"
done


